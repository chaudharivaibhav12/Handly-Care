# Copy to .env and fill in. Never commit .env.
# From the Viam app: CONNECT tab -> API keys (Machine Default), and the machine's Remote address.
VIAM_ADDRESS=your-machine.xxxxxxxxxx.viam.cloud
VIAM_API_KEY_ID=paste-key-id
VIAM_API_KEY=paste-key
# Optional: real AI planner. Without it, a keyword planner is used.
ANTHROPIC_API_KEY=
# Or: an OpenRouter key (used instead of ANTHROPIC_API_KEY when set; same Claude models)
OPENROUTER_API_KEY=
